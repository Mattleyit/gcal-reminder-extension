# ---------------------------------------------------------------------------
# gcal-reminder-extension - configurazione OAuth (Google Cloud Console)
#
# Questo file e' un TEMPLATE versionato: contiene solo valori pubblici.
# Copialo in .env (gia' in .gitignore) se ti serve in locale per script di
# build o packaging. L'estensione NON legge questo file a runtime: i valori
# effettivi vivono in manifest.json sotto "key" e "oauth2".
#
# Perche' e' sicuro tenerli qui: un Client ID OAuth di tipo Chrome Extension
# e' un identificatore pubblico, non un segreto. Non esiste un client_secret
# per questo tipo di client: il flusso chrome.identity.getAuthToken e' un
# flusso pubblico e Google lega il client all'Extension ID, non a un segreto.
# Il vero segreto del progetto e' la chiave privata .pem (vedi docs/).
# ---------------------------------------------------------------------------

# Progetto Google Cloud
GCP_PROJECT_NAME=gcal-reminder-extension
GCP_PROJECT_ID=gcal-reminder-extension-509219
GCP_PROJECT_NUMBER=185581795549

# OAuth 2.0 client - tipo "Estensione di Chrome"
# Va replicato in manifest.json -> oauth2.client_id
GOOGLE_OAUTH_CLIENT_ID=185581795549-6gq1a8dg02rm5u68c0gg23448u23srjg.apps.googleusercontent.com

# Unico scope richiesto (sola lettura del calendario)
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.readonly

# Extension ID deterministico, derivato dalla chiave pubblica in
# manifest.json -> key. Identico in locale (unpacked) e sul Chrome Web Store.
EXTENSION_ID=ghoaagpljnphhilolmhpbndjhabpfcbo

# Percorso della chiave privata usata per firmare il .crx.
# NON committare mai il file .pem (e' coperto da .gitignore).
EXTENSION_KEY_PATH=./gcal-reminder-extension.pem
